@model IEnumerable<LibrarySystem.Models.BorrowRecord>

@{
    ViewData["Title"] = "Borrow Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>Borrow Records</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Add New Record
    </a>
</div>

<!-- Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 bg-primary text-white shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-collection-fill fs-2 me-3"></i>
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.TotalCount</div>
                    <div class="small">Total Records</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-warning text-dark shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-clock-fill fs-2 me-3"></i>
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.BorrowedCount</div>
                    <div class="small">Currently Borrowed</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-success text-white shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-2 me-3"></i>
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.ReturnedCount</div>
                    <div class="small">Returned</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                       placeholder="Search by borrower name or book title..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Status</label>
                <select name="statusFilter" class="form-select">
                    <option value="">All Status</option>
                    <option value="Borrowed" selected="@(ViewBag.StatusFilter == "Borrowed")">Borrowed</option>
                    <option value="Returned" selected="@(ViewBag.StatusFilter == "Returned")">Returned</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Records Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No records found.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Add First Record</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Borrower Name</th>
                            <th>Book Title</th>
                            <th>Borrow Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">@item.BorrowId</td>
                                <td class="fw-semibold">@item.BorrowerName</td>
                                <td>@item.BookTitle</td>
                                <td>@item.BorrowDate.ToString("MMM dd, yyyy")</td>
                                <td>@(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("MMM dd, yyyy") : "-")</td>
                                <td>
                                    @if (item.Status == "Returned")
                                    {
                                        <span class="badge bg-success">Returned</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Borrowed</span>
                                    }
                                </td>
                                <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.BorrowId" class="btn btn-sm btn-outline-info me-1" title="Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.BorrowId" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.BorrowId" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
