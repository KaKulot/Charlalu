@model LibrarySystem.Models.BorrowRecord

@{
    ViewData["Title"] = "Record Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-eye me-2"></i>Borrow Record Details</h5>
            </div>
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-4 text-muted">Record ID</dt>
                    <dd class="col-sm-8">#@Model.BorrowId</dd>

                    <dt class="col-sm-4 text-muted">Borrower Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.BorrowerName</dd>

                    <dt class="col-sm-4 text-muted">Book Title</dt>
                    <dd class="col-sm-8">@Model.BookTitle</dd>

                    <dt class="col-sm-4 text-muted">Borrow Date</dt>
                    <dd class="col-sm-8">@Model.BorrowDate.ToString("MMMM dd, yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Return Date</dt>
                    <dd class="col-sm-8">@(Model.ReturnDate.HasValue ? Model.ReturnDate.Value.ToString("MMMM dd, yyyy") : "Not yet returned")</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "Returned")
                        {
                            <span class="badge bg-success fs-6">Returned</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6">Borrowed</span>
                        }
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.BorrowId" class="btn btn-warning text-dark">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
